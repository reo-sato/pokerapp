{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokerapp.local/contracts/action.schema.json",
  "title": "Action",
  "version": "1.1",
  "description": "ActionRecord.to_dict() の契約（hand core, ADR-0010 R5）。ISSUE-0011 の決定により additionalProperties:true で 1.0（false 昇格は後続、範囲膨張防止）。ADR-0009 の推定 additive フィールドは optional。1.1 (ADR-A G2, additive): reason / apply_ok を追加し、監査フィールド一式（actor_source / corrected_from / reason / asr_confidence / apply_ok）を rules-aware 経路が実際に emit する。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "hand_id", "timestamp", "street", "seat", "player_name", "action", "amount",
    "pot_after", "stack_after", "source", "needs_review", "confidence"
  ],
  "properties": {
    "hand_id": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "description": "ISO 8601。event.timestamp 由来（ADR-B T3: live と replay で同義）。"},
    "street": {"type": "string"},
    "seat": {"type": "integer", "minimum": 1, "maximum": 9},
    "player_name": {"type": "string"},
    "action": {"enum": ["bet", "call", "raise", "check", "fold", "allin", "showdown", "winner", "new_hand"]},
    "amount": {"type": "integer", "minimum": 0},
    "pot_after": {"type": "integer", "minimum": 0},
    "stack_after": {"type": "integer", "minimum": 0},
    "source": {
      "type": "object",
      "properties": {
        "camera": {"type": "boolean"},
        "audio": {"type": "boolean"},
        "rfid": {"type": "boolean"}
      }
    },
    "needs_review": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "legal_actions": {"type": "array", "items": {"type": "string"}},
    "amount_to_call": {"type": "integer", "minimum": 0},
    "corrected_from": {"type": ["string", "null"], "description": "修復前の生 ASR action"},
    "actor_source": {"type": ["string", "null"], "description": "actor 推定の根拠: rfid | spoken_seat | engine_prior | unresolved"},
    "asr_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "description": "射影/合成/競合の監査理由（複数は '+' 区切り, ADR-A G2）"},
    "apply_ok": {"type": "boolean", "description": "pokerkit が受理したか（false = state 非反映のレコード, ADR-A G2）"}
  }
}
