{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokerapp.local/contracts/reconstruction_event.schema.json",
  "title": "ReconstructionEvent",
  "version": "0.2",
  "description": "R1 (ADR-0010): 記録される生センサーイベントの envelope。AudioEvent / RFIDEvent / CameraEvent を type で判別する discriminated union。camera frame は除外。seat / confidence は audio の additive (ADR-0009, R3) で optional。0.2 (ADR-A/B, additive): audio に utterance_start_ts（発話開始時刻, 照合窓の始端）と parse_flags（パース曖昧性）を追加（既定値のとき省略 = 旧 replay 互換）。詳細は docs/contracts/event-replay.md §3。",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "timestamp"],
  "properties": {
    "type": {"enum": ["audio", "rfid", "camera"]},
    "timestamp": {"type": "number", "description": "time.time() 由来の秒。replay の clock 源 (§4)。"},
    "action": {"type": "string"},
    "amount": {"type": "integer", "minimum": 0},
    "raw_text": {"type": "string"},
    "seat": {"type": ["integer", "null"], "minimum": 1, "maximum": 9},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Whisper per-segment 信頼度 (ADR-0009 additive)。"},
    "utterance_start_ts": {"type": "number", "description": "発話キャプチャ開始時刻 (ADR-B T1 additive)。欠損時は timestamp を窓始端に使う。"},
    "parse_flags": {"type": "array", "items": {"enum": ["ambiguous_amount", "multi_action_keywords"]}, "description": "パース時に検出した曖昧性 (ADR-A additive)。非空なら needs_review。"},
    "tag_id": {"type": "string"},
    "card": {"type": "string"},
    "reader_id": {"type": "string"},
    "role": {"enum": ["seat", "board"]},
    "board_index": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "raw_tag_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"required": ["type"], "properties": {"type": {"const": "audio"}}},
      "then": {"required": ["action", "amount", "raw_text"]}
    },
    {
      "if": {"required": ["type"], "properties": {"type": {"const": "rfid"}}},
      "then": {"required": ["tag_id", "card", "reader_id", "role"]}
    },
    {
      "if": {"required": ["type"], "properties": {"type": {"const": "camera"}}},
      "then": {"required": ["seat"]}
    }
  ]
}
