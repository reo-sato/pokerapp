{
  "session": {
    "num_seats": 6,
    "blinds": {"sb": 100, "bb": 200},
    "log_dir": "./logs"
  },
  "camera": {
    "device_id": 0,
    "resolution": [1280, 720],
    "fps": 20,
    "roi": {},
    "motion_threshold": 2000
  },
  "audio": {
    "engine": "whisper",
    "device_id": 0,
    "sample_rate": 16000,
    "whisper_model": "medium",
    "language": "ja",
    "initial_prompt": "ベット コール レイズ チェック フォールド オールイン ショーダウン ウィナー ハンド開始",
    "normalization_file": "./speech_normalization.json",
    "vosk_model_path": "./models/vosk-model-ja-0.22",
    "vosk_grammar": null,
    "vosk_volume_threshold": 0,
    "_vosk_notes": "grammar: vosk-model-ja-0.22 は runtime graph 非対応のため null 固定 / volume_threshold: 0=無効, 500〜1500 が目安（RMS, int16スケール）"
  },
  "rfid": {
    "enabled": false,
    "transport": "serial",
    "_transport_comment": "serial=ESP32-S3 USB直結(USB-CDC, 既定) / http=ESP32-S3 WiFi / pcsc=USB NFCリーダー直結",
    "serial_port": "/dev/ttyACM0",
    "baudrate": 115200,
    "reconnect_interval_ms": 2000,
    "_serial_comment": "serial_port は Win='COM3' / mac='/dev/tty.usbmodemXXXX'。pyserial 必須",
    "bind_host": "0.0.0.0",
    "bind_port": 8787,
    "card_master_file": "./rfid_cards.json",
    "readers": {
      "seat_1": {"role": "seat",  "seat": 1},
      "seat_2": {"role": "seat",  "seat": 2},
      "seat_3": {"role": "seat",  "seat": 3},
      "seat_4": {"role": "seat",  "seat": 4},
      "seat_5": {"role": "seat",  "seat": 5},
      "seat_6": {"role": "seat",  "seat": 6},
      "seat_7": {"role": "seat",  "seat": 7},
      "seat_8": {"role": "seat",  "seat": 8},
      "seat_9": {"role": "seat",  "seat": 9},
      "board_1": {"role": "board", "index": 1},
      "board_2": {"role": "board", "index": 2},
      "board_3": {"role": "board", "index": 3},
      "board_4": {"role": "board", "index": 4},
      "board_5": {"role": "board", "index": 5}
    },
    "_pcsc_transport_comment": "transport='pcsc' の場合は以下を使用 (pyscard 必須)",
    "_pcsc_poll_interval_ms": 100
  }
}
