{
  "session": {
    "num_seats": 6,
    "button_seat_initial": 1,
    "blinds": {"sb": 100, "bb": 200},
    "log_dir": "./logs"
  },
  "audio": {
    "device_id": 0,
    "sample_rate": 16000,
    "whisper_model": "medium",
    "language": "ja",
