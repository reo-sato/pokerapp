11. ディレクトリ構成

pokerapp/
+-- CLAUDE.md                      開発者向けガイド
+-- sprc_v4.docx                   本仕様書
+-- main.py                        エントリーポイント
+-- config.json                    ユーザー設定
+-- config_default.json            デフォルト設定テンプレート
+-- rfid_cards.json                tag_id -> card_code マスタ
+-- corrections.json               音声誤認識補正テーブル
+-- speech_normalization.json      音声正規化辞書
+-- requirements.txt
|
+-- core/
|   +-- config.py                  config.json ロード・保存
|   +-- constants.py               ACTION_KEYWORDS, KANJI_DIGIT/UNIT, WHISPER_PROMPT_JA
|   +-- event_queue.py             EventQueue
|   +-- events.py                  AudioEvent, CameraEvent, RFIDEvent
|   +-- game_state.py              GameStateManager
|   +-- hand_log.py                ActionRecord, HandSummary
|
+-- audio/
|   +-- recorder.py                AudioThread (PyAudio + faster-whisper)
|   +-- vosk_recorder.py           VoskAudioThread (Vosk)
|   +-- recognizer.py              parse_action(), parse_amount(), apply_corrections()
|   +-- speech_normalizer.py       SpeechNormalizer, NormalizedResult
|
+-- rfid/
|   +-- http_receiver.py           RFIDHTTPReceiver
|   +-- reader_thread.py           RFIDThread (PC/SC)
|   +-- bridge.py                  RFID ブリッジユーティリティ
|   +-- card_master.py             CardMaster
|
+-- integration/
|   +-- engine.py                  IntegrationThread, calc_confidence()
|   +-- action_inference.py        BettingState, InferredAction, infer_action()
|
+-- output/
|   +-- json_writer.py             JsonWriter
|   +-- phh_exporter.py            PHHExporter
|
+-- gui/
|   +-- dashboard.py               GUIDashboard
|
+-- tests/                         pytest テストスイート (243 テスト)
+-- logs/                          セッションログ出力先


